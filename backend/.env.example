# Copy this file to .env and fill in real values (do NOT commit secrets)

# Application
APP_NAME=LIGHTBURGH EMR
API_VERSION=v1
APP_ENV=development
DEBUG=True

# Database (replace placeholders)
POSTGRES_USER=lm_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lm_emr
DATABASE_URL=postgresql+psycopg://lm_admin:password@localhost:5432/lm_emr

# Security
JWT_SECRET_KEY=replace-with-secure-32+chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_FAILED_LOGIN_ATTEMPTS=5

# Notes:
# - Store production secrets in your CI/CD or a secrets manager (GitHub Secrets, Vault).
# - Don't commit real secrets to the repository.
# ==========================================================
# LIGHTBURGH EMR - Example Production Configuration
# ==========================================================

APP_NAME=LIGHTBURGH EMR
API_VERSION=v1
APP_ENV=production
DEBUG=False
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Database
POSTGRES_USER=lm_admin
POSTGRES_PASSWORD=lm_password
POSTGRES_DB=lm_emr
DATABASE_URL=postgresql+psycopg://lm_admin:lm_password@postgres:5432/lm_emr

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage
STORAGE_MAX_FILE_SIZE_MB=20
STORAGE_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png

# Security
JWT_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_FAILED_LOGIN_ATTEMPTS=5
